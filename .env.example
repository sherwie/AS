# ============================================
# SOLANA MEME EARLY SIGNAL BOT - CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# The system works WITHOUT API keys in "no-keys" mode
# Add keys progressively to unlock additional features

# ============================================
# DATABASE (Required)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solana_signal
REDIS_URL=redis://localhost:6379

# ============================================
# SOLANA RPC (Works with public endpoint)
# ============================================
# Default public RPC (rate-limited, but works for basic detection)
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS=wss://api.mainnet-beta.solana.com

# Optional: Helius for better rate limits and enhanced data
# Get key at: https://www.helius.dev/
# HELIUS_API_KEY=your_helius_api_key
# HELIUS_RPC_HTTP=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
# HELIUS_RPC_WS=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# ============================================
# ALERTING - Discord Webhook (Recommended)
# ============================================
# Create webhook: Server Settings > Integrations > Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ============================================
# SOCIAL CONNECTORS (All Optional)
# ============================================

# --- Telegram Bot ---
# Create bot via @BotFather, get token
# TELEGRAM_BOT_TOKEN=your_bot_token
# Comma-separated list of chat IDs to monitor (bot must be member)
# TELEGRAM_CHAT_IDS=-1001234567890,-1009876543210

# --- Twitter/X API ---
# Requires X API access: https://developer.twitter.com/
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# X_BEARER_TOKEN=

# --- Discord Bot (for monitoring servers) ---
# DISCORD_BOT_TOKEN=
# Comma-separated channel IDs
# DISCORD_CHANNEL_IDS=

# ============================================
# MARKET DATA PROVIDERS (All have public tiers)
# ============================================
# DexScreener - No key required for public API
DEXSCREENER_ENABLED=true

# GeckoTerminal - No key required for public API
GECKOTERMINAL_ENABLED=true

# Birdeye - Optional API key for better limits
# BIRDEYE_API_KEY=

# Jupiter - No key required (public quote API)
JUPITER_ENABLED=true

# ============================================
# FEATURE FLAGS
# ============================================
# Modes: GENESIS (early detection) | IGNITION (momentum) | BOTH
SIGNAL_MODE=BOTH

# DEX Support
ENABLE_RAYDIUM=true
ENABLE_ORCA=true
ENABLE_METEORA=true
ENABLE_PUMPFUN=true

# Social Connectors
ENABLE_TELEGRAM=false
ENABLE_TWITTER=false
ENABLE_DISCORD_MONITOR=false

# ============================================
# SCORING THRESHOLDS
# ============================================
# Genesis mode thresholds
GENESIS_SURVIVAL_MIN=60
GENESIS_RUNNER_MIN=40

# Ignition mode thresholds
IGNITION_SURVIVAL_MIN=50
IGNITION_RUNNER_MIN=70

# Hard reject threshold (below this = auto-reject)
HARD_REJECT_SURVIVAL=20

# ============================================
# SAFETY FILTERS
# ============================================
# Minimum liquidity in SOL equivalent
MIN_LIQUIDITY_SOL=1
# Maximum top holder concentration (excluding LPs)
MAX_TOP_HOLDER_PCT=50
# Reject if freeze authority exists
REJECT_FREEZE_AUTHORITY=true
# Reject if mint authority exists (not revoked)
REJECT_MINT_AUTHORITY=true

# ============================================
# RATE LIMITS (requests per minute)
# ============================================
RPC_RATE_LIMIT=100
DEXSCREENER_RATE_LIMIT=30
GECKOTERMINAL_RATE_LIMIT=30
JUPITER_RATE_LIMIT=60

# ============================================
# SYSTEM
# ============================================
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
METRICS_PORT=9090
